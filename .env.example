# ---- required ----
# Reuse the old backend's JWT_SECRET to keep existing logins valid
JWT_SECRET=replace_with_a_long_random_secret
# Shared key for service-to-service calls (/internal/**)
INTERNAL_KEY=replace_with_another_long_random_secret

# ---- admin login (same as the old backend) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
JWT_EXPIRES=7d

# ---- integrations (same values as the old Backend/.env) ----
GOOGLE_CLIENT_ID=
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- browser origins the gateway accepts (only matters when not using the nginx proxy) ----
CORS_ORIGIN=http://localhost,http://localhost:5173
